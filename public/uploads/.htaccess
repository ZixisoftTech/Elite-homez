# Security: Prevent execution of any scripts in the uploads directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Force default handler
SetHandler default-handler

# Disable CGI execution
Options -ExecCGI -Indexes
